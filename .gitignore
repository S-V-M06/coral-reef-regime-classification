# Local Python environments and caches
.venv/
__pycache__/
*.py[cod]
.pytest_cache/
.env

# Legacy draft-generation files may remain when updating an existing folder;
# do not publish drafts or nested review archives.
make_drafts.py
make_one_page_draft.py
docs/PROJECT_*_DRAFT.*
results_review.zip

# Downloaded public dataset is fetched by the pipeline and is not committed.
data/Hawaii_RegimesPredictors.txt

# Large/non-source outputs are regenerated by run_project.py.
results/*.joblib
results/*.png

# Temporary assets used only while building the polished PDF / PowerPoint
.build_assets/
